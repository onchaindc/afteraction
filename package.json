{
  "name": "afteraction",
  "version": "1.0.0",
  "description": "Incident communications studio built with @hyper-elements/react: enter an incident once, get a postmortem PDF, a status page, a stakeholder email and a visual summary.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
